{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/api/admin/:path*" },
    { "source": "/:path*.php", "destination": "/api/:path*.php" },
    { "source": "/", "destination": "/api/index.php" }
  ]
}
